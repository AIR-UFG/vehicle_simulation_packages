<?xml version="1.0"?>
<package format="3">
  <name>bounding_box_plugin</name>
  <version>0.0.0</version>
  <description>ROS 2 Gazebo plugin that publishes the bounding box of a model.</description>

  <maintainer email="your.email@example.com">Victor Matteus</maintainer>

  <license>Apache-2.0</license>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rosidl_default_runtime</exec_depend>


  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>gazebo_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>bounding_box_msg</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
